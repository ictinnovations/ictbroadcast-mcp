# ICTBroadcast MCP server configuration.
ICTBROADCAST_BASE_URL=https://your-ictbroadcast
ICTBROADCAST_USERNAME=admin
ICTBROADCAST_PASSWORD=change-me

# Optional: unlock start/stop campaign (live outbound calling). Off by default.
# ICTBROADCAST_MCP_ALLOW_WRITE=true

# Optional tuning.
# ICTBROADCAST_TIMEOUT_MS=30000
# ICTBROADCAST_TLS_INSECURE=false
